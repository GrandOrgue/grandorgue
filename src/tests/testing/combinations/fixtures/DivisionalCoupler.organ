; Used by GOTestDivisionalSetter::TestDivisionalCoupler.
; Two manuals, no Pedal (HasPedals=N), each with its own associated Switch,
; coupled by an engaged, bidirectional DivisionalCoupler001. Exercises the
; coupled-manual loop in SwitchDivisionalTo/ProcessPushDivisional that
; contained the original bug: each manual first gets its own combination via
; its own Set press, then recalling the divisional on one manual (Set not
; active) must also recall the other manual's combination through the
; coupler.
[Organ]
ChurchName=Test organ
ChurchAddress=Test address
NumberOfManuals=2
HasPedals=N
NumberOfWindchestGroups=1
NumberOfEnclosures=0
NumberOfSwitches=2
NumberOfTremulants=0
NumberOfReversiblePistons=0
NumberOfGenerals=0
NumberOfDivisionalCouplers=1
DivisionalsStoreIntermanualCouplers=N
DivisionalsStoreIntramanualCouplers=N
DivisionalsStoreTremulants=N
GeneralsStoreDivisionalCouplers=N

[WindchestGroup001]
NumberOfEnclosures=0
NumberOfTremulants=0

[Switch001]
Name=Switch1
DefaultToEngaged=N

[Switch002]
Name=Switch2
DefaultToEngaged=N

[Manual001]
Name=Manual1
NumberOfLogicalKeys=61
FirstAccessibleKeyLogicalKeyNumber=1
FirstAccessibleKeyMIDINoteNumber=36
NumberOfAccessibleKeys=61
NumberOfStops=0
NumberOfSwitches=1
Switch001=1

[Manual002]
Name=Manual2
NumberOfLogicalKeys=61
FirstAccessibleKeyLogicalKeyNumber=1
FirstAccessibleKeyMIDINoteNumber=36
NumberOfAccessibleKeys=61
NumberOfStops=0
NumberOfSwitches=1
Switch001=2

[DivisionalCoupler001]
Name=DivCoupler
DefaultToEngaged=Y
BiDirectionalCoupling=Y
NumberOfManuals=2
Manual001=1
Manual002=2
